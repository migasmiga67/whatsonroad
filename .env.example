# ── Claude API (ranking i opisy postojów) ───────────────────────────────
# Bez klucza aplikacja działa, ale używa rankingu heurystycznego.
ANTHROPIC_API_KEY=
# Model i "effort" (low | medium | high) – low wystarcza do rankingu i jest najszybszy.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# ── OpenRouteService / HeiGIT (trasa + geokodowanie) ────────────────────
# Darmowy klucz: https://account.heigit.org/signup
# Bez klucza (lub gdy ORS odmówi) aplikacja używa OSRM + Nominatim.
ORS_API_KEY=
# auto = ORS z fallbackiem na OSRM/Nominatim | ors = tylko ORS | osrm = tylko OSRM/Nominatim
ROUTING_PROVIDER=auto
# Od 24.11.2026 stary host api.openrouteservice.org zwraca 410 – API jest pod api.heigit.org.
ORS_BASE_URL=https://api.heigit.org/openrouteservice
ORS_GEOCODE_URL=https://api.heigit.org/pelias/v1

# ── Darmowe API bez klucza ──────────────────────────────────────────────
OSRM_URL=https://router.project-osrm.org
# Lista serwerów Overpass (po przecinku) – kolejne są używane, gdy poprzedni nie odpowiada.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter
WIKIPEDIA_LANG=pl
# Nominatim i Wikipedia wymagają identyfikującego User-Agent (najlepiej z kontaktem).
HTTP_USER_AGENT=PoDrodze/0.1 (planer postojow; https://github.com/migasmiga67/whatsonroad)

# ── Cache odpowiedzi API (pliki JSON) ───────────────────────────────────
CACHE_DIR=.cache
